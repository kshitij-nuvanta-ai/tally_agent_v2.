# --- Tally connection ---
TALLY_HOST=localhost
TALLY_PORT=9000

# --- Claude API ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_CLASSIFIER_MODEL=claude-haiku-4-5-20251001
EVAL_JUDGE_MODEL=claude-opus-4-6

# --- App server ---
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
SESSION_TTL_MINUTES=60

# --- Frontend ---
VITE_API_URL=http://localhost:8000
# Set to true to enable auth pages + sidebar (requires DATABASE_URL on backend)
# VITE_DB_MODE=true

# --- DB mode (optional) ---
# Uncomment all DB vars together to switch backend from legacy (in-memory) to
# Postgres-backed mode with auth, workspaces, and persistent conversations.
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost/tallyagent
# JWT_SECRET=replace-with-a-random-string-at-least-32-characters-long
# JWT_ACCESS_TOKEN_EXPIRY_MINUTES=30
# JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# --- Agent sync (optional; needs the DB vars above) ---
# Signs the desktop agent's device tokens. At least 32 characters, and different from JWT_SECRET.
# DEVICE_TOKEN_SECRET=replace-with-another-random-string-at-least-32-characters
# Everything below has a default; uncomment only to change it.
# DEVICE_ACCESS_MINUTES=15
# DEVICE_REFRESH_DAYS=90
# TAKEOVER_LOGIN_MAX_AGE_MINUTES=10
# INGEST_MAX_GZIP_BYTES=5242880
# INGEST_MAX_DECOMPRESSED_BYTES=52428800
# INGEST_MAX_OBJECTS=500
# PARITY_TOLERANCE_PAISE=100
# QUARANTINE_ERROR_THRESHOLD=50
# STORAGE_ALERT_BYTES=5368709120
# LOGIN_RATE_MAX=5
# LOGIN_RATE_WINDOW_S=900
# DEVICE_RATE_MAX=600
# DEVICE_RATE_WINDOW_S=60
# MAINTENANCE_SLICE_SECONDS=2.0
# MAINTENANCE_SLICE_ROWS=5000
# STORAGE_ESTIMATE_INTERVAL_SECONDS=3600
# PURGE_GRACE_DAYS=30
# The old V2_-prefixed names (V2_DEVICE_TOKEN_SECRET, V2_DATABASE_URL, V2_WEB_JWT_SECRET, ...) are still read;
# the new name wins when both are set. V2_PORT is no longer used.

# --- DB integration tests (optional) ---
# Separate database used by the DB tests (tests/integration, tests/e2e, tests/sync). The migration tests also
# create and drop throwaway databases named <this database>_mig_<random> on the same server.
# TEST_DATABASE_URL=postgresql+asyncpg://user:pass@localhost/tallyagent_test
